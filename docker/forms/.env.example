# Copy to `.env` (git-ignored) and fill in real values, or render from SOPS:
#   sops -d ../../secrets/secrets.sops.yaml | yq '.forms' > .env
#
# SECURITY: the running container currently exposes this key in plaintext env,
# and it may be baked into the forms image layers (built by CI). Rotate it in
# the Anthropic console and inject it only at runtime via this file.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
