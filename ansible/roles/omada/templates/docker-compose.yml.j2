# Managed by Ansible (roles/omada). Edits here are overwritten.
services:
  omada-controller:
    image: {{ omada_image }}
    container_name: omada-controller
    restart: unless-stopped
    # Host networking: device discovery/adoption uses L2 broadcasts and a
    # long list of ports (8043 web UI, 29810-29817, 27001, 19810).
    network_mode: host
    ulimits:
      nofile:
        soft: 4096
        hard: 8192
    stop_grace_period: 60s
    environment:
      TZ: "{{ omada_tz }}"
      MANAGE_HTTPS_PORT: "8043"
      PORTAL_HTTPS_PORT: "8843"
      SHOW_SERVER_LOGS: "true"
      SHOW_MONGODB_LOGS: "false"
    volumes:
      - {{ omada_dir }}/data:/opt/tplink/EAPController/data
      - {{ omada_dir }}/logs:/opt/tplink/EAPController/logs
